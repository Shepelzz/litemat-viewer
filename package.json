    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "mysql2": "^3.24.5",
    "three": "0.147.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
