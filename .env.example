# cp .env.example .env   (.env is git-ignored). On Render these go to the service's Environment tab instead.
#
# MySQL for «Поделиться». Without it the viewer works, sharing is just switched off.
# DATABASE_URL=mysql://user:password@host:3306/dbname
# or separately:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=
# DB_SSL=true        # if the provider requires TLS
# DB_POOL=5
#
# Google sign-in («Поделиться» needs it too): OAuth client id from Google Cloud Console.
# Add the site's origin (and http://localhost:5231, http://localhost:5173) to «Authorized JavaScript origins».
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
#
# PORT=5231          # API/server port (Render sets its own)
# SITE_URL=https://litemat-viewer.onrender.com   # absolute URLs in link-preview tags (build time)
